# Optional. Mosaic works without this using Wikimedia Commons, with a bundled catalog fallback.
PIXABAY_API_KEY=
# Optional AI expansion for suggested/related visual-search phrases. Search still works without it.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash-lite
PORT=3001
HOST=
# Direct hosting: 0. Render single reverse proxy: 1.
TRUST_PROXY_HOPS=0
# Optional location override, useful for isolated testing/deployment.
DATABASE_PATH=

# Optional direct image uploads. Create an unsigned Cloudinary upload preset.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Optional email verification for new accounts. When both are set, signup requires
# a 6-digit code delivered through Resend.
RESEND_API_KEY=
EMAIL_FROM=
